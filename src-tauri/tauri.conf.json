{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scythe Agent",
  "version": "0.1.0",
  "identifier": "dev.darkeden.scythe-agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Scythe Agent",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": [
      "../backend/app/**/*",
      "../backend/alembic/**/*",
      "../backend/alembic.ini",
      "../backend/pyproject.toml",
      "../backend/uv.lock"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
